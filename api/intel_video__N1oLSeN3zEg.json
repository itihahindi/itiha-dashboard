atchRatio":0.45255},{"ratio":0.93,"watchRatio":0.4476},{"ratio":0.94,"watchRatio":0.44489999999999996},{"ratio":0.95,"watchRatio":0.43879999999999997},{"ratio":0.96,"watchRatio":0.4322},{"ratio":0.97,"watchRatio":0.4226},{"ratio":0.98,"watchRatio":0.40835},{"ratio":0.99,"watchRatio":0.39625},{"ratio":1,"watchRatio":0.3913}],"script":{"source_path":"2026-10-anime-ramayana-blocked.md","words":122,"wpm":null,"lang":"en","chapters":[],"blocks":[{"sec":0,"text":"You grew up watching this golden anime"},{"sec":2.2,"text":"Ramayana, but it was banned by the"},{"sec":3.8,"text":"Indian government for a silly reason."},{"sec":5.7,"text":"This film was created by Japanese"},{"sec":7.6,"text":"filmmaker alongside Indian animation"},{"sec":9.7,"text":"legend, but just as the film was nearing"},{"sec":11.7,"text":"completion, India was reeling from a"},{"sec":13.3,"text":"massive political events, the demolition"},{"sec":15.4,"text":"of Babri Masjid and communal violence"},{"sec":17.4,"text":"that followed later. Some objected to"},{"sec":19.5,"text":"portraying Hindu deities as cartoon"},{"sec":21.6,"text":"characters, while the wider political"},{"sec":23.4,"text":"climate made this film's Indian release"},{"sec":25.4,"text":"difficult. It premiered at an Indian"},{"sec":27.3,"text":"festival in 1993, but the Congress"},{"sec":29.5,"text":"government fearing communal violence"},{"sec":31.6,"text":"banned its release. But something"},{"sec":33.2,"text":"changed 3 years later, the movie finally"},{"sec":35.4,"text":"played on television and the film was so"},{"sec":37.4,"text":"good that it became core memory of whole"},{"sec":39.3,"text":"generation."}],"text":""}}