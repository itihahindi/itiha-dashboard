watchRatio":0.4391},{"ratio":0.96,"watchRatio":0.4325},{"ratio":0.97,"watchRatio":0.4233},{"ratio":0.98,"watchRatio":0.41100000000000003},{"ratio":0.99,"watchRatio":0.3969},{"ratio":1,"watchRatio":0.3908}],"script":{"source_path":"2026-09-monier-williams-boden-chair.md","words":195,"wpm":null,"lang":"en","chapters":[],"blocks":[{"sec":0,"text":"This Oxford Professor was hired to"},{"sec":1.9,"text":"convert India to Christianity. This is"},{"sec":3.8,"text":"not a conspiracy theory. It was in his"},{"sec":5.8,"text":"job description. An old company colonel"},{"sec":8,"text":"left his fortune to Oxford and wrote"},{"sec":9.8,"text":"into his will exactly what Boden"},{"sec":11.6,"text":"Professor was for. Translate the Bible"},{"sec":13.8,"text":"into Sanskrit so Englishmen could"},{"sec":15.6,"text":"proceed in the conversion of the natives"},{"sec":17.3,"text":"in India. Now, in 1860, that job came"},{"sec":19.8,"text":"open and the obvious man for it was Max"},{"sec":22,"text":"Müller. He spent 12 years in Oxford"},{"sec":24.1,"text":"editing Rigveda. Everyone knew he was a"},{"sec":26.1,"text":"better scholar. Everyone knew he would"},{"sec":27.8,"text":"win, but he lost and here's why. It was"},{"sec":29.9,"text":"never about Sanskrit scholarship. It was"},{"sec":31.7,"text":"about who would carry out the founder's"},{"sec":33.5,"text":"wish and Monier Williams said it openly,"},{"sec":36,"text":"his job was a missionary's job and he"},{"sec":37.9,"text":"kept his promise. 17 years later, he"},{"sec":40.1,"text":"wrote that every Englishman [music] in"},{"sec":41.5,"text":"India should act as a missionary until"},{"sec":43.6,"text":"every native confess that Jesus Christ"},{"sec":45.5,"text":"is Lord. So, why does it matter today?"},{"sec":47.6,"text":"Because in 1899, he finished the"},{"sec":49.5,"text":"Sanskrit dictionary that is still the"},{"sec":51.2,"text":"standard and the way he read Hinduism"},{"sec":53.1,"text":"through a Christian lens is still how"},{"sec":54.8,"text":"Western academia reads today."}],"text":""}}