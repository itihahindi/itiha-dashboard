hRatio":0.45255},{"ratio":0.93,"watchRatio":0.4476},{"ratio":0.94,"watchRatio":0.44489999999999996},{"ratio":0.95,"watchRatio":0.43845},{"ratio":0.96,"watchRatio":0.4322},{"ratio":0.97,"watchRatio":0.42264999999999997},{"ratio":0.98,"watchRatio":0.40980000000000005},{"ratio":0.99,"watchRatio":0.39669999999999994},{"ratio":1,"watchRatio":0.3913}],"script":{"source_path":"z89hgwY0No4.en-orig.vtt","words":149,"wpm":null,"lang":"en","chapters":[],"blocks":[{"sec":0,"text":"If Muslims had destroyed temples, there"},{"sec":2.1,"text":"would not have been so many temples."},{"sec":4,"text":">> Jahangir didn't Shah Jahan didn't"},{"sec":5.7,"text":">> Except their own records tell a"},{"sec":7.3,"text":"completely different [music] story."},{"sec":8.7,"text":"Abdul Hamid Lahori was Shah Jahan's"},{"sec":10.8,"text":"court historian. He records that emperor"},{"sec":12.9,"text":"ordered every temple still being built"},{"sec":15,"text":"across the empire torn down. 76 temples"},{"sec":17.8,"text":"were destroyed just in Varanasi alone."},{"sec":20.2,"text":"Now, you could argue that was just a"},{"sec":22.7,"text":"court historian exaggerating to praise"},{"sec":24.9,"text":"his emperor. But I want you to think"},{"sec":26.8,"text":"about that mindset which appreciates"},{"sec":28.6,"text":"this kind of glorification. So let's go"},{"sec":30.7,"text":"back and read what his father Jahangir"},{"sec":33.1,"text":"wrote himself in his own personal"},{"sec":34.9,"text":"memoirs. Jahangir records visiting"},{"sec":37,"text":"Varaha temple at Pushkar where he"},{"sec":38.9,"text":"personally ordered the deity smashed and"},{"sec":41,"text":"thrown into the lake. Our eminent"},{"sec":42.8,"text":"historian Irfan Habib says emperors"},{"sec":45,"text":"never destroyed temples, but their own"},{"sec":47,"text":"court historians and their own memoirs"},{"sec":49.5,"text":"say they did."}],"text":""}}