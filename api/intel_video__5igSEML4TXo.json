},{"ratio":0.49,"watchRatio":0.5986},{"ratio":0.5,"watchRatio":0.59665},{"ratio":0.51,"watchRatio":0.59155},{"ratio":0.52,"watchRatio":0.5875},{"ratio":0.53,"watchRatio":0.5846},{"ratio":0.54,"watchRatio":0.57845},{"ratio":0.55,"watchRatio":0.5749},{"ratio":0.56,"watchRatio":0.5704},{"ratio":0.57,"watchRatio":0.5674},{"ratio":0.58,"watchRatio":0.5588500000000001},{"ratio":0.59,"watchRatio":0.55635},{"ratio":0.6,"watchRatio":0.5518000000000001},{"ratio":0.61,"watchRatio":0.5487},{"ratio":0.62,"watchRatio":0.5444},{"ratio":0.63,"watchRatio":0.5418000000000001},{"ratio":0.64,"watchRatio":0.53835},{"ratio":0.65,"watchRatio":0.5347999999999999},{"ratio":0.66,"watchRatio":0.5319},{"ratio":0.67,"watchRatio":0.5299},{"ratio":0.68,"watchRatio":0.5258499999999999},{"ratio":0.69,"watchRatio":0.5226500000000001},{"ratio":0.7,"watchRatio":0.52095},{"ratio":0.71,"watchRatio":0.518},{"ratio":0.72,"watchRatio":0.5157},{"ratio":0.73,"watchRatio":0.51335},{"ratio":0.74,"watchRatio":0.51},{"ratio":0.75,"watchRatio":0.5082500000000001},{"ratio":0.76,"watchRatio":0.5057},{"ratio":0.77,"watchRatio":0.503},{"ratio":0.78,"watchRatio":0.5002},{"ratio":0.79,"watchRatio":0.4971},{"ratio":0.8,"watchRatio":0.49555},{"ratio":0.81,"watchRatio":0.4929},{"ratio":0.82,"watchRatio":0.49035},{"ratio":0.83,"watchRatio":0.48675},{"ratio":0.84,"watchRatio":0.48505000000000004},{"ratio":0.85,"watchRatio":0.48255000000000003},{"ratio":0.86,"watchRatio":0.48085},{"ratio":0.87,"watchRatio":0.4761},{"ratio":0.88,"watchRatio":0.471},{"ratio":0.89,"watchRatio":0.46595},{"ratio":0.9,"watchRatio":0.464},{"ratio":0.91,"watchRatio":0.45840000000000003},{"ratio":0.92,"watchRatio":0.4528},{"ratio":0.93,"watchRatio":0.4476},{"ratio":0.94,"watchRatio":0.44475},{"ratio":0.95,"watchRatio":0.43975},{"ratio":0.96,"watchRatio":0.4322},{"ratio":0.97,"watchRatio":0.42279999999999995},{"ratio":0.98,"watchRatio":0.41075},{"ratio":0.99,"watchRatio":0.39725},{"ratio":1,"watchRatio":0.3913}],"script":{"source_path":"5igSEML4TXo.en-orig.vtt","words":138,"wpm":null,"lang":"en","chapters":[],"blocks":[{"sec":1.8,"text":"No one expects every filmmaker to"},{"sec":3.6,"text":"reproduce Valmiki's Ramayana word to"},{"sec":6,"text":"word. Creative freedom is part of the"},{"sec":7.9,"text":"tradition. Countless poets brought their"},{"sec":10.3,"text":"own interpretation to the epic. They"},{"sec":12,"text":"added their own creativity, their own"},{"sec":13.8,"text":"literary style, and their own"},{"sec":15.3,"text":"perspective. But they never abandoned"},{"sec":17.5,"text":"the moral heart of the story. That"},{"sec":19.4,"text":"reading of Ravana does not come from"},{"sec":21.3,"text":"Kamban or Tulsidas. It comes from"},{"sec":23.4,"text":"left-leaning retelling of the epic. When"},{"sec":25.3,"text":"cinematic adoption does that, it raises"},{"sec":27.6,"text":"a bigger question. Have we changed the"},{"sec":29.3,"text":"way the story is told or have we changed"},{"sec":31.6,"text":"what the story is trying to say? The"},{"sec":33.4,"text":"Ramayana survived because every"},{"sec":34.9,"text":"generation found a way to tell it while"},{"sec":36.9,"text":"preserving its central moral conflict."},{"sec":39,"text":"Today's cinema has that responsibility"},{"sec":40.9,"text":"because how we tell Ramayana now will"},{"sec":43.2,"text":"shape what the next generation"},{"sec":44.6,"text":"understands about it."}],"text":""}}