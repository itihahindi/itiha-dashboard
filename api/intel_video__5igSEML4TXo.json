"ratio":0.55,"watchRatio":0.5743},{"ratio":0.56,"watchRatio":0.5695},{"ratio":0.57,"watchRatio":0.5667},{"ratio":0.58,"watchRatio":0.5581499999999999},{"ratio":0.59,"watchRatio":0.5558000000000001},{"ratio":0.6,"watchRatio":0.55165},{"ratio":0.61,"watchRatio":0.5479499999999999},{"ratio":0.62,"watchRatio":0.54375},{"ratio":0.63,"watchRatio":0.5409999999999999},{"ratio":0.64,"watchRatio":0.5377000000000001},{"ratio":0.65,"watchRatio":0.5338},{"ratio":0.66,"watchRatio":0.5317000000000001},{"ratio":0.67,"watchRatio":0.5286},{"ratio":0.68,"watchRatio":0.5253},{"ratio":0.69,"watchRatio":0.5214000000000001},{"ratio":0.7,"watchRatio":0.5207999999999999},{"ratio":0.71,"watchRatio":0.518},{"ratio":0.72,"watchRatio":0.51505},{"ratio":0.73,"watchRatio":0.5133000000000001},{"ratio":0.74,"watchRatio":0.5095000000000001},{"ratio":0.75,"watchRatio":0.508},{"ratio":0.76,"watchRatio":0.5057},{"ratio":0.77,"watchRatio":0.50285},{"ratio":0.78,"watchRatio":0.49795},{"ratio":0.79,"watchRatio":0.49655000000000005},{"ratio":0.8,"watchRatio":0.4948},{"ratio":0.81,"watchRatio":0.4911},{"ratio":0.82,"watchRatio":0.489},{"ratio":0.83,"watchRatio":0.4854},{"ratio":0.84,"watchRatio":0.4828},{"ratio":0.85,"watchRatio":0.4815},{"ratio":0.86,"watchRatio":0.47985},{"ratio":0.87,"watchRatio":0.47440000000000004},{"ratio":0.88,"watchRatio":0.46885},{"ratio":0.89,"watchRatio":0.4666},{"ratio":0.9,"watchRatio":0.4647},{"ratio":0.91,"watchRatio":0.45840000000000003},{"ratio":0.92,"watchRatio":0.45255},{"ratio":0.93,"watchRatio":0.4476},{"ratio":0.94,"watchRatio":0.44489999999999996},{"ratio":0.95,"watchRatio":0.43879999999999997},{"ratio":0.96,"watchRatio":0.4322},{"ratio":0.97,"watchRatio":0.4226},{"ratio":0.98,"watchRatio":0.40835},{"ratio":0.99,"watchRatio":0.39625},{"ratio":1,"watchRatio":0.3913}],"script":{"source_path":"5igSEML4TXo.en-orig.vtt","words":138,"wpm":null,"lang":"en","chapters":[],"blocks":[{"sec":1.8,"text":"No one expects every filmmaker to"},{"sec":3.6,"text":"reproduce Valmiki's Ramayana word to"},{"sec":6,"text":"word. Creative freedom is part of the"},{"sec":7.9,"text":"tradition. Countless poets brought their"},{"sec":10.3,"text":"own interpretation to the epic. They"},{"sec":12,"text":"added their own creativity, their own"},{"sec":13.8,"text":"literary style, and their own"},{"sec":15.3,"text":"perspective. But they never abandoned"},{"sec":17.5,"text":"the moral heart of the story. That"},{"sec":19.4,"text":"reading of Ravana does not come from"},{"sec":21.3,"text":"Kamban or Tulsidas. It comes from"},{"sec":23.4,"text":"left-leaning retelling of the epic. When"},{"sec":25.3,"text":"cinematic adoption does that, it raises"},{"sec":27.6,"text":"a bigger question. Have we changed the"},{"sec":29.3,"text":"way the story is told or have we changed"},{"sec":31.6,"text":"what the story is trying to say? The"},{"sec":33.4,"text":"Ramayana survived because every"},{"sec":34.9,"text":"generation found a way to tell it while"},{"sec":36.9,"text":"preserving its central moral conflict."},{"sec":39,"text":"Today's cinema has that responsibility"},{"sec":40.9,"text":"because how we tell Ramayana now will"},{"sec":43.2,"text":"shape what the next generation"},{"sec":44.6,"text":"understands about it."}],"text":""}}