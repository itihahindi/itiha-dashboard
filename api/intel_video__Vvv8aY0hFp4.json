0.4476},{"ratio":0.94,"watchRatio":0.44489999999999996},{"ratio":0.95,"watchRatio":0.43825000000000003},{"ratio":0.96,"watchRatio":0.4322},{"ratio":0.97,"watchRatio":0.42300000000000004},{"ratio":0.98,"watchRatio":0.40980000000000005},{"ratio":0.99,"watchRatio":0.39725},{"ratio":1,"watchRatio":0.39294999999999997}],"script":{"source_path":"2026-09-neem-karoli-steve-jobs.md","words":143,"wpm":null,"lang":"en","chapters":[],"blocks":[{"sec":0,"text":"Steve Jobs [music] went looking for this"},{"sec":1.7,"text":"saint in 1974."},{"sec":4.6,"text":"He never met him and it still changed"},{"sec":6.5,"text":"his life. He was 19, dropped out of"},{"sec":8.7,"text":"college, flown to Delhi and taken"},{"sec":10.5,"text":"trains, buses into the Himalayas to find"},{"sec":12.6,"text":"one man, Neem Karoli Baba. When he"},{"sec":14.4,"text":"finally reached ashram, Baba had been"},{"sec":16.6,"text":"dead for months. He got dysentery,"},{"sec":18.6,"text":"rented a room in village and lay there"},{"sec":20.3,"text":"for weeks. And in that room, someone had"},{"sec":22.5,"text":"left a book behind. He read it lying"},{"sec":24.2,"text":"sick in a Himalayan village and then"},{"sec":25.8,"text":"read it every year for the rest of his"},{"sec":27.4,"text":"life. And he wasn't the only one who"},{"sec":29.1,"text":"came. Decades later, when Facebook was"},{"sec":31,"text":"struggling, Jobs told Mark Zuckerberg to"},{"sec":33.1,"text":"go to the same temple. When Steve Jobs"},{"sec":35,"text":"died, at his memorial, every guest was"},{"sec":37.2,"text":"handed a small brown box. [music] Inside"},{"sec":39.7,"text":"was that book."}],"text":""}}