watchRatio":0.46485},{"ratio":0.9,"watchRatio":0.46285},{"ratio":0.91,"watchRatio":0.4583},{"ratio":0.92,"watchRatio":0.4518},{"ratio":0.93,"watchRatio":0.4476},{"ratio":0.94,"watchRatio":0.44489999999999996},{"ratio":0.95,"watchRatio":0.43825000000000003},{"ratio":0.96,"watchRatio":0.4322},{"ratio":0.97,"watchRatio":0.42300000000000004},{"ratio":0.98,"watchRatio":0.40980000000000005},{"ratio":0.99,"watchRatio":0.39725},{"ratio":1,"watchRatio":0.39294999999999997}],"script":{"source_path":"2026-10-madras-famine-temple-wage.md","words":183,"wpm":null,"lang":"en","chapters":[],"blocks":[{"sec":0,"text":"Hitler fed his prisoners in"},{"sec":1.6,"text":"concentration camps better than Britain"},{"sec":3.4,"text":"fed starving Indians. In 1877, famine"},{"sec":6.2,"text":"gripped Madras Presidency, but the"},{"sec":7.7,"text":"Viceroy had one priority, protect"},{"sec":9.8,"text":"imperial profits. He dispatched Sir"},{"sec":11.9,"text":"Richard Temple to Madras with direct"},{"sec":14,"text":"orders to slash relief cost. Temple came"},{"sec":16.6,"text":"with a brutal formula. If you wanted"},{"sec":18.3,"text":"[music] a single meal, you had to walk"},{"sec":20,"text":"miles to relief camp and work all day."},{"sec":22.5,"text":"Your entire wage, 1 lb of rice. That"},{"sec":25.5,"text":"sounds like aid until you run the math."},{"sec":28,"text":"Breaking granite under tropical sun"},{"sec":30.3,"text":"burns over 3,000 calories a day. The"},{"sec":32.4,"text":"Temple wage provided barely 1,600"},{"sec":34.7,"text":"calories. Victims at Hitler's"},{"sec":36.2,"text":"concentration camp received 1,750. Why"},{"sec":38.6,"text":"set the ration at a lethal deficit? 3"},{"sec":40.8,"text":"years earlier, [music] during the Bihar"},{"sec":42.2,"text":"famine, Temple had imported rice from"},{"sec":44.3,"text":"Burma, but London attacked him for"},{"sec":46.2,"text":"wasting tax revenue. He was not going to"},{"sec":48.4,"text":"risk his career twice. The result,"},{"sec":50.4,"text":"relief camps [music] became state-run"},{"sec":52.2,"text":"death camps. By the end of famine, over"},{"sec":54.3,"text":"9 million Indians were dead. As for"},{"sec":56.2,"text":"Richard Temple, that [music] same year,"},{"sec":57.7,"text":"British Crown promoted him to governor"},{"sec":59.7,"text":"of Bombay."}],"text":""}}