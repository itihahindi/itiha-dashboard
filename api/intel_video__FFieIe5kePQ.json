atio":0.91,"watchRatio":0.45840000000000003},{"ratio":0.92,"watchRatio":0.45255},{"ratio":0.93,"watchRatio":0.4476},{"ratio":0.94,"watchRatio":0.44489999999999996},{"ratio":0.95,"watchRatio":0.43845},{"ratio":0.96,"watchRatio":0.4322},{"ratio":0.97,"watchRatio":0.42264999999999997},{"ratio":0.98,"watchRatio":0.40980000000000005},{"ratio":0.99,"watchRatio":0.39669999999999994},{"ratio":1,"watchRatio":0.3913}],"script":{"source_path":"FFieIe5kePQ.en-orig.vtt","words":153,"wpm":null,"lang":"en","chapters":[],"blocks":[{"sec":0,"text":"In British India, five Hindu votes were"},{"sec":2,"text":"worth one Muslim vote. And it gets worse"},{"sec":4.1,"text":"because a Hindu always had to pay three"},{"sec":6.2,"text":"times more tax just to qualify for that"},{"sec":8.6,"text":"fraction of a vote. And this was no"},{"sec":10.4,"text":"accident. You see, in 1909, Congress-led"},{"sec":13.1,"text":"freedom struggle was picking up pace."},{"sec":14.8,"text":"So, the British built a counterweight."},{"sec":17,"text":"They encouraged Muslim leaders to stand"},{"sec":19,"text":"against Congress. And the Morley-Minto"},{"sec":21,"text":"Reforms split the voter rolls by"},{"sec":22.9,"text":"religion and handed Muslims far more"},{"sec":25.2,"text":"seats than their share of population."},{"sec":26.9,"text":"Did Congress fight it? No. Its leaders"},{"sec":29.1,"text":"agreed. But Savarkar pushed back. And"},{"sec":31.2,"text":"what he asked for was simple: one man,"},{"sec":33.5,"text":"one vote, equal rights for everyone, and"},{"sec":35.7,"text":"no special privileges. And for that, he"},{"sec":37.8,"text":"was called communal. So, what happened"},{"sec":39.6,"text":"to his warning? It was ignored. And in"},{"sec":41.4,"text":"1946 elections, the split became"},{"sec":43.8,"text":"permanent. And a year later, that"},{"sec":45.5,"text":"unequal voting system tore the country"},{"sec":47.3,"text":"in"}],"text":""}}