o":0.42,"watchRatio":0.62575},{"ratio":0.43,"watchRatio":0.6229},{"ratio":0.44,"watchRatio":0.61725},{"ratio":0.45,"watchRatio":0.6106},{"ratio":0.46,"watchRatio":0.6056},{"ratio":0.47,"watchRatio":0.6031},{"ratio":0.48,"watchRatio":0.59945},{"ratio":0.49,"watchRatio":0.5963},{"ratio":0.5,"watchRatio":0.5903499999999999},{"ratio":0.51,"watchRatio":0.58555},{"ratio":0.52,"watchRatio":0.58195},{"ratio":0.53,"watchRatio":0.58295},{"ratio":0.54,"watchRatio":0.5771},{"ratio":0.55,"watchRatio":0.5743},{"ratio":0.56,"watchRatio":0.5695},{"ratio":0.57,"watchRatio":0.5667},{"ratio":0.58,"watchRatio":0.5581499999999999},{"ratio":0.59,"watchRatio":0.5558000000000001},{"ratio":0.6,"watchRatio":0.55165},{"ratio":0.61,"watchRatio":0.5479499999999999},{"ratio":0.62,"watchRatio":0.54375},{"ratio":0.63,"watchRatio":0.5409999999999999},{"ratio":0.64,"watchRatio":0.5377000000000001},{"ratio":0.65,"watchRatio":0.5338},{"ratio":0.66,"watchRatio":0.5317000000000001},{"ratio":0.67,"watchRatio":0.5286},{"ratio":0.68,"watchRatio":0.5253},{"ratio":0.69,"watchRatio":0.5214000000000001},{"ratio":0.7,"watchRatio":0.5207999999999999},{"ratio":0.71,"watchRatio":0.518},{"ratio":0.72,"watchRatio":0.51505},{"ratio":0.73,"watchRatio":0.5133000000000001},{"ratio":0.74,"watchRatio":0.5095000000000001},{"ratio":0.75,"watchRatio":0.508},{"ratio":0.76,"watchRatio":0.5057},{"ratio":0.77,"watchRatio":0.50285},{"ratio":0.78,"watchRatio":0.49795},{"ratio":0.79,"watchRatio":0.49655000000000005},{"ratio":0.8,"watchRatio":0.4948},{"ratio":0.81,"watchRatio":0.4911},{"ratio":0.82,"watchRatio":0.489},{"ratio":0.83,"watchRatio":0.4854},{"ratio":0.84,"watchRatio":0.4828},{"ratio":0.85,"watchRatio":0.4815},{"ratio":0.86,"watchRatio":0.47985},{"ratio":0.87,"watchRatio":0.47440000000000004},{"ratio":0.88,"watchRatio":0.46885},{"ratio":0.89,"watchRatio":0.4666},{"ratio":0.9,"watchRatio":0.4647},{"ratio":0.91,"watchRatio":0.45840000000000003},{"ratio":0.92,"watchRatio":0.45255},{"ratio":0.93,"watchRatio":0.4476},{"ratio":0.94,"watchRatio":0.44489999999999996},{"ratio":0.95,"watchRatio":0.43879999999999997},{"ratio":0.96,"watchRatio":0.4322},{"ratio":0.97,"watchRatio":0.4226},{"ratio":0.98,"watchRatio":0.40835},{"ratio":0.99,"watchRatio":0.39625},{"ratio":1,"watchRatio":0.3913}],"script":{"source_path":"GRVNYHaRAc8.en-orig.vtt","words":348,"wpm":null,"lang":"en","chapters":[],"blocks":[{"sec":0,"text":"Mysore's Dasara celebrations isn't the"},{"sec":2,"text":"original. 500 years ago, the real one"},{"sec":4,"text":"happened here in Vijayanagara. And on"},{"sec":5.6,"text":"the last day, the emperor did something"},{"sec":7.7,"text":"that decided his next war."},{"sec":9.8,"text":"You see, in 1520, a Portuguese horse"},{"sec":12.1,"text":"trader called Domingo Paes watched all"},{"sec":14.3,"text":"of it. And the first thing he saw was a"},{"sec":16.2,"text":"massive granite platform covered in"},{"sec":18.4,"text":"carvings, the center of it all. This is"},{"sec":21.1,"text":"where every vassal king in the empire"},{"sec":23.4,"text":"walked up, and none of them came"},{"sec":25,"text":"empty-handed. Each one had to bow and"},{"sec":27.2,"text":"pay his taxes right here in front of"},{"sec":29.5,"text":"everyone. And sitting on the top of the"},{"sec":31.3,"text":"platform was one figure even emperor"},{"sec":33.7,"text":"bowed to."},{"sec":34.9,"text":"That was goddess Durga, and"},{"sec":36.5,"text":"Krishnadevaraya himself sat before her"},{"sec":38.8,"text":"in puja every morning. And what he"},{"sec":41.1,"text":"offered grew every single day. By the"},{"sec":43.3,"text":"last day, it was 250 buffaloes and"},{"sec":46,"text":"thousands of sheep and goats."},{"sec":47.8,"text":">> [music]"},{"sec":47.9,"text":">> And that was just the mornings. The"},{"sec":49.7,"text":"afternoons were for the fights. A"},{"sec":51.4,"text":"thousand wrestlers with spiked rings on"},{"sec":53.5,"text":"their fists showing off their skills."},{"sec":55.3,"text":"And then Paes saw something he had never"},{"sec":57.3,"text":"seen back home, a woman wrestling with"},{"sec":59.6,"text":"men in front of the king. Some of these"},{"sec":61.5,"text":"matches turned bloody while the crowd"},{"sec":63.5,"text":"cheered."},{"sec":65.1,"text":"Over the years, the ambassadors from"},{"sec":67,"text":"Portugal, Persia, China came to the"},{"sec":69.2,"text":"festival with gifts for the emperor"},{"sec":71,"text":"because this was when Vijayanagara"},{"sec":72.6,"text":"empire showed its military might to the"},{"sec":74.6,"text":"world. So, what happened when sun went"},{"sec":76.6,"text":"down? Well, that's when the real party"},{"sec":78.5,"text":"started. Lamps were lit along every"},{"sec":80.4,"text":"wall. Dancers performed before the"},{"sec":82,"text":"goddess. And the arena filled with"},{"sec":83.8,"text":"fireworks, and the whole city stayed up"},{"sec":85.8,"text":"to watch. But the last day was"},{"sec":87.3,"text":"different. The army lined on the road"},{"sec":90,"text":"out of the city. And when the emperor"},{"sec":91.7,"text":"rode past, they banged their shields"},{"sec":93.4,"text":"until the ground shook."},{"sec":97.3,"text":"Then, he picked up a bow and shot three"},{"sec":99.6,"text":"arrows. One towards Bijapur, one towards"},{"sec":101.8,"text":"Golconda, and one towards Portuguese."},{"sec":103.9,"text":"Wherever the furthest arrow landed,"},{"sec":106,"text":"that's where his next war would be."},{"sec":108.5,"text":"After Vijayanagara fell, Wodeyars of"},{"sec":110.4,"text":"Mysore kept the festival alive."}],"text":""}}