o":0.47,"watchRatio":0.6031},{"ratio":0.48,"watchRatio":0.59945},{"ratio":0.49,"watchRatio":0.5963},{"ratio":0.5,"watchRatio":0.5903499999999999},{"ratio":0.51,"watchRatio":0.58555},{"ratio":0.52,"watchRatio":0.58195},{"ratio":0.53,"watchRatio":0.58295},{"ratio":0.54,"watchRatio":0.5771},{"ratio":0.55,"watchRatio":0.5743},{"ratio":0.56,"watchRatio":0.5695},{"ratio":0.57,"watchRatio":0.5667},{"ratio":0.58,"watchRatio":0.5581499999999999},{"ratio":0.59,"watchRatio":0.5558000000000001},{"ratio":0.6,"watchRatio":0.55165},{"ratio":0.61,"watchRatio":0.5479499999999999},{"ratio":0.62,"watchRatio":0.54375},{"ratio":0.63,"watchRatio":0.5409999999999999},{"ratio":0.64,"watchRatio":0.5377000000000001},{"ratio":0.65,"watchRatio":0.5338},{"ratio":0.66,"watchRatio":0.5317000000000001},{"ratio":0.67,"watchRatio":0.5286},{"ratio":0.68,"watchRatio":0.5253},{"ratio":0.69,"watchRatio":0.5214000000000001},{"ratio":0.7,"watchRatio":0.5207999999999999},{"ratio":0.71,"watchRatio":0.518},{"ratio":0.72,"watchRatio":0.51505},{"ratio":0.73,"watchRatio":0.5133000000000001},{"ratio":0.74,"watchRatio":0.5095000000000001},{"ratio":0.75,"watchRatio":0.508},{"ratio":0.76,"watchRatio":0.5057},{"ratio":0.77,"watchRatio":0.50285},{"ratio":0.78,"watchRatio":0.49795},{"ratio":0.79,"watchRatio":0.49655000000000005},{"ratio":0.8,"watchRatio":0.4948},{"ratio":0.81,"watchRatio":0.4911},{"ratio":0.82,"watchRatio":0.489},{"ratio":0.83,"watchRatio":0.4854},{"ratio":0.84,"watchRatio":0.4828},{"ratio":0.85,"watchRatio":0.4815},{"ratio":0.86,"watchRatio":0.47985},{"ratio":0.87,"watchRatio":0.47440000000000004},{"ratio":0.88,"watchRatio":0.46885},{"ratio":0.89,"watchRatio":0.4666},{"ratio":0.9,"watchRatio":0.4647},{"ratio":0.91,"watchRatio":0.45840000000000003},{"ratio":0.92,"watchRatio":0.45255},{"ratio":0.93,"watchRatio":0.4476},{"ratio":0.94,"watchRatio":0.44489999999999996},{"ratio":0.95,"watchRatio":0.43879999999999997},{"ratio":0.96,"watchRatio":0.4322},{"ratio":0.97,"watchRatio":0.4226},{"ratio":0.98,"watchRatio":0.40835},{"ratio":0.99,"watchRatio":0.39625},{"ratio":1,"watchRatio":0.3913}],"script":{"source_path":"2026-09-william-jones-asiatic-society.md","words":185,"wpm":null,"lang":"en","chapters":[],"blocks":[{"sec":0,"text":"This guy's started a club to study"},{"sec":1.8,"text":"Indian history and banned Indians from"},{"sec":3.8,"text":"joining it. And that's not even the"},{"sec":5.3,"text":"strange part. When William Jones started"},{"sec":7.4,"text":"Asiatic Society to study Hindu"},{"sec":9.3,"text":"scriptures, laws, and history, he"},{"sec":11.2,"text":"employed an army of Brahmins to do the"},{"sec":13.5,"text":"actual translation. They could work for"},{"sec":15.4,"text":"the society, but they couldn't join it."},{"sec":17.2,"text":"Now, here's where it gets really"},{"sec":18.5,"text":"strange. Jones, a devout Anglican"},{"sec":20.7,"text":"Christian, believed in biblical"},{"sec":22.3,"text":"timelines. The world was created in 4004"},{"sec":24.8,"text":"BC, and nothing could have survived"},{"sec":26.6,"text":"Noah's flood. But there was a problem."},{"sec":28.5,"text":"Hindu scriptures talk about ages running"},{"sec":30.6,"text":"into millions of years. So, Jones called"},{"sec":32.8,"text":"that allegory and squeezed every Indian"},{"sec":34.8,"text":"king, every scripture into the years"},{"sec":36.8,"text":"after the flood. Anything that didn't"},{"sec":38.6,"text":"fit biblical worldview became a myth."},{"sec":40.9,"text":"And that's the timeline Indology started"},{"sec":43.1,"text":"from. And it gets worse. In 1875, an"},{"sec":45.7,"text":"Indian scholar named Rajendralal Mitra"},{"sec":47.9,"text":"published the first survey of Orissa's"},{"sec":49.8,"text":"temple. Britain's leading architectural"},{"sec":51.9,"text":"historian argued that as an Indian race,"},{"sec":54.5,"text":"Mitra wasn't capable of scholarly work."},{"sec":56.5,"text":"That mindset never left Western"},{"sec":58,"text":"academia. It still decides who gets to"},{"sec":60,"text":"explain Hinduism."}],"text":""}}