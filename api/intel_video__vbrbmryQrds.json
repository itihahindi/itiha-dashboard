o":0.4322},{"ratio":0.97,"watchRatio":0.42264999999999997},{"ratio":0.98,"watchRatio":0.40980000000000005},{"ratio":0.99,"watchRatio":0.39669999999999994},{"ratio":1,"watchRatio":0.3913}],"script":{"source_path":"vbrbmryQrds.en-orig.vtt","words":149,"wpm":null,"lang":"en","chapters":[],"blocks":[{"sec":0.1,"text":"Ramayana movie is accused of making"},{"sec":2,"text":"Ravana the good guy. But the British"},{"sec":3.8,"text":"cooked that up first. It goes back to"},{"sec":5.6,"text":"1882 when a British administrator called"},{"sec":8,"text":"William Hunter wrote a book and he"},{"sec":9.8,"text":"decided to play the race card. He"},{"sec":11.6,"text":"stripped away the sacred Dharma and"},{"sec":13.3,"text":"turned the Ramayana into Aryan invasion"},{"sec":15.2,"text":"of South. But there was a problem. In"},{"sec":16.7,"text":"Hunter's version, the invading Aryans"},{"sec":18.5,"text":"were heroes, which means Ravana was"},{"sec":20.5,"text":"still the villain. So who made him a"},{"sec":22.1,"text":"good guy? Well, the British wrote a"},{"sec":23.8,"text":"story as a race war to justify their"},{"sec":25.7,"text":"rule over India. Few years later, that"},{"sec":27.9,"text":"story got a new life. Dravidian"},{"sec":29.6,"text":"politicians picked up that exact British"},{"sec":31.6,"text":"race war, kept that colonial script and"},{"sec":33.8,"text":"flipped the roles so that Ravana became"},{"sec":35.7,"text":"the hero. The story was served by modern"},{"sec":37.8,"text":"politicians, but the whole thing was"},{"sec":39.4,"text":"cooked up in 19th century British"},{"sec":40.9,"text":"libraries."}],"text":""}}