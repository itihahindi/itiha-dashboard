atchRatio":0.3908}],"script":{"source_path":"2026-11-ram-setu-adams-bridge.md","words":162,"wpm":null,"lang":"en","chapters":[],"blocks":[{"sec":0,"text":"Lord Rama crossed to Lanka on Ramasetu."},{"sec":2.2,"text":"But, if you look at maps today, it's"},{"sec":3.7,"text":"called Adam's Bridge. So, how did"},{"sec":5.3,"text":"Ramasetu become Adam's Bridge? Well, in"},{"sec":7.8,"text":"1788, the East India Company's Surveyor"},{"sec":10,"text":"General published his map of India. And"},{"sec":12.2,"text":"on it, the bridge was labeled as Adam's"},{"sec":14.2,"text":"Bridge. So, where did he get Adam from?"},{"sec":16.6,"text":"Well, not anyone in India. The Arab"},{"sec":18.6,"text":"merchants had adopted the story of Adam"},{"sec":21.2,"text":"to Indian subcontinent. That Adam,"},{"sec":23.2,"text":"thrown out of Eden, landed on mountain"},{"sec":25.2,"text":"in Sri Lanka and walked across the"},{"sec":27,"text":"bridge into [music] India. But,"},{"sec":28.3,"text":"thousands of years before that,"},{"sec":29.8,"text":"Buddhists and Hindus were already"},{"sec":31.3,"text":"worshipping the footprint on top of that"},{"sec":33.2,"text":"mountain. But, even before this medieval"},{"sec":35.2,"text":"Islamic legend became [music] popular,"},{"sec":36.8,"text":"the Persian scholar Al-Biruni called it"},{"sec":39.2,"text":"Setubandha. And the name Adam came much"},{"sec":41.8,"text":"later. So, yeah, Hindus had called it"},{"sec":43.8,"text":"Ramasetu for thousands of years. Arab"},{"sec":45.9,"text":"merchants gave it to Adam, and the"},{"sec":47.6,"text":"British just copied the name onto their"}],"text":""}}