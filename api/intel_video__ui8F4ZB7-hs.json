chRatio":0.4476},{"ratio":0.94,"watchRatio":0.44489999999999996},{"ratio":0.95,"watchRatio":0.43845},{"ratio":0.96,"watchRatio":0.4322},{"ratio":0.97,"watchRatio":0.42264999999999997},{"ratio":0.98,"watchRatio":0.40980000000000005},{"ratio":0.99,"watchRatio":0.39669999999999994},{"ratio":1,"watchRatio":0.3913}],"script":{"source_path":"ui8F4ZB7-hs.en-orig.vtt","words":218,"wpm":null,"lang":"en","chapters":[],"blocks":[{"sec":0,"text":"British bureaucrats in India with the"},{"sec":1.8,"text":"highest paid imperialist, and India was"},{"sec":3.8,"text":"still paying them after 1947. Even a"},{"sec":6.3,"text":"junior officer's house ran on an army of"},{"sec":8.7,"text":"Indian servants. He lived in a whites"},{"sec":10.6,"text":"only part of a town and drank at clubs"},{"sec":12.8,"text":"that didn't admit any Indians, and he"},{"sec":14.9,"text":"spent his holidays in hill stations,"},{"sec":17.1,"text":"horse races, theater, expensive galas."},{"sec":19.9,"text":"So who was paying for all this? Well,"},{"sec":22,"text":"the farmer was. Land tax was due in cash"},{"sec":24.8,"text":"no matter what the harvest did. And"},{"sec":26.5,"text":"here's how it was collected. Under"},{"sec":28.3,"text":"British rule, farmers who couldn't pay"},{"sec":30.1,"text":"were locked in cages in sun, and fathers"},{"sec":32.3,"text":"sold their children to clear the dues."},{"sec":34.3,"text":"Dadabhai Naoroji found that quarter of"},{"sec":36.4,"text":"India's revenue left London every year,"},{"sec":38.5,"text":"and most of it was under salaries and"},{"sec":40.3,"text":"pensions. And eventually somebody pushed"},{"sec":42.5,"text":"back. In 1879, a clerk named Vasudev"},{"sec":45.2,"text":"Balwant Phadke raised a rebellion over"},{"sec":47.2,"text":"the high salaries of British"},{"sec":48.5,"text":"bureaucrats, and the pay was never cut."},{"sec":50.5,"text":"An officer still got four years of paid"},{"sec":52.6,"text":"leave back home and retired at 50 on a"},{"sec":55,"text":"£1,000 a year pension and lived"},{"sec":57.3,"text":"comfortably in English countryside while"},{"sec":59.3,"text":"the Indians were starving. And here's"},{"sec":61,"text":"the part that sucks. Even after"},{"sec":62.5,"text":"independence, Indian political class"},{"sec":64.5,"text":"continued to pay the pensions of British"},{"sec":66.6,"text":"officers who served in India."}],"text":""}}