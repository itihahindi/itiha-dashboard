hRatio":0.4233},{"ratio":0.98,"watchRatio":0.41100000000000003},{"ratio":0.99,"watchRatio":0.3969},{"ratio":1,"watchRatio":0.3908}],"script":{"source_path":"0to1_uA8hQA.en-orig.vtt","words":122,"wpm":null,"lang":"en","chapters":[],"blocks":[{"sec":0,"text":"This man said Rama was a cowardly"},{"sec":2.6,"text":"politician and Ravana the ultimate"},{"sec":4.8,"text":"gentleman and he wasn't joking. E.V."},{"sec":6.9,"text":"Ramaswamy wanted to turn Ramayana upside"},{"sec":9.5,"text":"down. He argued that the epic was North"},{"sec":11.8,"text":"Indian propaganda used by Brahmins to"},{"sec":14,"text":"oppress Dravidian people. So he stripped"},{"sec":16.3,"text":"Rama of his divine status, portrayed him"},{"sec":18.6,"text":"as a backstabber and a symbol of caste"},{"sec":20.8,"text":"oppression. But here's where it gets"},{"sec":22.5,"text":"wilder. Periyar recast Ravana as an"},{"sec":25.2,"text":"educated, honorable South Indian king"},{"sec":27.6,"text":"who never touched Sita without her"},{"sec":29.3,"text":"consent. And Periyar didn't keep his"},{"sec":31.2,"text":"ideas inside a book. He took the outrage"},{"sec":33.6,"text":"straight to the streets. While North"},{"sec":35.3,"text":"India was burning Ravana effigies during"},{"sec":37.4,"text":"festivals, Periyar marched onto Madras"},{"sec":39.8,"text":"Beach in 1956 and publicly burned"},{"sec":42.4,"text":"pictures of Rama."}],"text":""}}