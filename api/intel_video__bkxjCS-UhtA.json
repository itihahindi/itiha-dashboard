4,"watchRatio":0.4457},{"ratio":0.95,"watchRatio":0.4391},{"ratio":0.96,"watchRatio":0.4322},{"ratio":0.97,"watchRatio":0.4233},{"ratio":0.98,"watchRatio":0.41100000000000003},{"ratio":0.99,"watchRatio":0.39759999999999995},{"ratio":1,"watchRatio":0.3918}],"script":{"source_path":"bkxjCS-UhtA.en-orig.vtt","words":170,"wpm":null,"lang":"en","chapters":[],"blocks":[{"sec":0.1,"text":"Sonia Gandhi's new biography is making"},{"sec":2,"text":"the news, but one thing is missing from"},{"sec":3.7,"text":"it, her conflict with PV Narasimha Rao."},{"sec":5.6,"text":"It goes back to 1991. After the death of"},{"sec":7.9,"text":"Rajiv Gandhi, Narasimha Rao was elected"},{"sec":10,"text":"to lead Congress and Sonia Gandhi"},{"sec":11.8,"text":"expected a puppet, but Rao turned out to"},{"sec":13.9,"text":"be more competent than she could imagine"},{"sec":16.1,"text":"and the rivalry grew until one phone"},{"sec":18.5,"text":"call. She made him wait on the line and"},{"sec":20.7,"text":"Rao told her, I don't mind waiting, but"},{"sec":23,"text":"the Prime Minister of India does. So"},{"sec":24.6,"text":"Sonia Gandhi's ego was hurt. She took a"},{"sec":26.8,"text":"revenge over his dead body. Rao died in"},{"sec":29.3,"text":"Delhi and his family wanted his last"},{"sec":31.5,"text":"rites at Delhi, his Karmabhoomi, but the"},{"sec":33.8,"text":"Home Minister Shivraj Patil refused a"},{"sec":36,"text":"state funeral at Delhi and it got worse"},{"sec":38.2,"text":"next day. On its way out of Delhi, the"},{"sec":40.4,"text":"funeral procession stopped at Congress"},{"sec":42.6,"text":"headquarters and the gates stayed"},{"sec":44.6,"text":"closed. Every congressman knew who gave"},{"sec":46.8,"text":"those orders. A Prime Minister of India"},{"sec":48.8,"text":"was insulted by its own party."}],"text":""}}